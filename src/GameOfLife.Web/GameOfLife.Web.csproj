<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Workstation GC: the app is one process on a small, shared host (one universe, a handful of
      clients) where the server GC's per-core heaps would cost memory for nothing.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameOfLife.Core\GameOfLife.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marker attributes for the TypeScript client generator (TypedSignalR.Client.TypeScript / Tapper). -->
    <PackageReference Include="Tapper.Attributes" Version="1.14.0" />
    <PackageReference Include="TypedSignalR.Client.TypeScript.Attributes" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client sources, node_modules and build script are not part of the published app; wwwroot/dist is. -->
    <Content Remove="Scripts\**" />
    <Content Remove="node_modules\**" />
    <Content Remove="build.mjs" />
    <None Include="Scripts\**" />
    <!-- Written by the build itself; watching them would make dotnet watch rebuild in a loop. -->
    <None Update="Scripts\generated\**" Watch="false" />
    <Content Include="..\..\patterns\*.rle" Link="patterns\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      wwwroot/dist is declared by DeclareClientAssets below, after the client build, never by the
      evaluation-time glob: chunk names carry content hashes, so the glob would list files the build
      is about to delete and the static web assets step would fail on them.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Client build, run before the SDK collects static web assets (ResolveProjectStaticWebAssets), so
    that the bundles are fingerprinted, pre-compressed and listed in the endpoint manifest that
    MapStaticAssets serves from:
      1. RestoreDotnetTools    - dotnet tool restore from the repo's .config/dotnet-tools.json (pins the generator version).
      2. GenerateSignalRClient - emits Scripts/generated/*.ts from [Hub] ILifeHub, [Receiver] ILifeClient and
                                 [TranspilationSource] types. The output is committed; review it like any other diff.
      3. NpmInstall            - npm ci when package-lock.json changed.
      4. BuildClient           - tsc (type check only) then esbuild into wwwroot/dist; minified for Release. The
                                 stamp that marks the output up to date lives in wwwroot/dist, which esbuild empties
                                 first, so a build in the other configuration cannot pass as up to date.
      5. DeclareClientAssets   - adds whatever wwwroot/dist now holds as Content (source maps build-only), whether
                                 the bundle step ran, was up to date, or was turned off.
    Steps 1-4 are incremental, skipped for IDE design-time builds, and can be turned off with
    dotnet build -p:SkipClientBuild=true (e.g. in a container without Node, with wwwroot/dist prebuilt).
  -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepoRoot>
    <SignalRClientOutputDir>$(MSBuildProjectDirectory)\Scripts\generated</SignalRClientOutputDir>
    <ClientBuildEnabled>false</ClientBuildEnabled>
    <ClientBuildEnabled Condition="'$(SkipClientBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">true</ClientBuildEnabled>
    <ClientBuildScript>build</ClientBuildScript>
    <ClientBuildScript Condition="'$(Configuration)' == 'Release'">build:release</ClientBuildScript>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything the generator reads. Keep hub interfaces and wire DTOs in these folders. -->
    <SignalRClientSource Include="Hubs\**\*.cs;Simulation\**\*.cs" />
    <SignalRClientOutput Include="$(SignalRClientOutputDir)\GameOfLife.Web.Simulation.ts" />
    <SignalRClientOutput Include="$(SignalRClientOutputDir)\TypedSignalR.Client\GameOfLife.Web.Hubs.ts" />
    <SignalRClientOutput Include="$(SignalRClientOutputDir)\TypedSignalR.Client\index.ts" />
    <ClientSource Include="Scripts\**\*.ts;Scripts\**\*.tsx;Scripts\**\*.css;tsconfig.json;build.mjs;package.json" />
  </ItemGroup>

  <Target Name="RestoreDotnetTools"
          Condition="'$(ClientBuildEnabled)' == 'true'"
          Inputs="$(RepoRoot).config\dotnet-tools.json"
          Outputs="$(IntermediateOutputPath)dotnet-tools.restored">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(RepoRoot)" />
    <Touch Files="$(IntermediateOutputPath)dotnet-tools.restored" AlwaysCreate="true" />
  </Target>

  <Target Name="GenerateSignalRClient"
          DependsOnTargets="RestoreDotnetTools"
          Condition="'$(ClientBuildEnabled)' == 'true'"
          Inputs="@(SignalRClientSource);$(MSBuildProjectFullPath)"
          Outputs="@(SignalRClientOutput)">
    <Message Importance="high" Text="Generating the TypeScript SignalR client into $(SignalRClientOutputDir)" />
    <!--
      The generator loads this project through MSBuildWorkspace, which is a full nested build of it.
      SkipClientBuild in its environment keeps that nested build from running these client targets
      (and rewriting the static web assets manifests under a different configuration). Its build
      diagnostics are informational; only its exit code decides.
    -->
    <Exec Command="dotnet dotnet-tsrts --project &quot;$(MSBuildProjectFullPath)&quot; --output &quot;$(SignalRClientOutputDir)&quot;"
          WorkingDirectory="$(RepoRoot)"
          EnvironmentVariables="SkipClientBuild=true"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="NpmInstall"
          Condition="'$(ClientBuildEnabled)' == 'true'"
          Inputs="package.json;package-lock.json"
          Outputs="node_modules\.package-lock.json">
    <Exec Command="npm ci" />
  </Target>

  <Target Name="BuildClient"
          DependsOnTargets="NpmInstall;GenerateSignalRClient"
          Condition="'$(ClientBuildEnabled)' == 'true'"
          Inputs="@(ClientSource)"
          Outputs="wwwroot\dist\client-$(Configuration).stamp">
    <Message Importance="high" Text="Type checking and bundling the client into wwwroot/dist ($(ClientBuildScript))" />
    <Exec Command="npm run $(ClientBuildScript)" />
    <Touch Files="wwwroot\dist\client-$(Configuration).stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="DeclareClientAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="BuildClient">
    <ItemGroup>
      <Content Include="wwwroot\dist\**" Exclude="wwwroot\dist\**\*.map;wwwroot\dist\*.stamp" />
      <Content Include="wwwroot\dist\**\*.map" CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>

</Project>
