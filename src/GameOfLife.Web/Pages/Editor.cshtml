@page
@model EditorModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Seed editor";
}

<h1 class="h3">Draw the initial state</h1>
<p class="text-body-secondary">
    Click a cell to toggle it. Use the arrow keys to move, Space or Enter to toggle, and drag to paint.
    The @EditorModel.GridSize × @EditorModel.GridSize grid is placed at the centre of the universe when you seed it.
</p>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

@*
    The React editor (Scripts/editor) mounts here and posts the same form fields (Name, Rle) back to
    this page, so the server-side validation and error handling are unchanged.
*@
<div id="editor-root"
     data-size="@EditorModel.GridSize"
     data-initial-rle="@Model.Rle"
     data-initial-name="@Model.Name"
     data-action="@Url.Page("/Editor")"
     data-index-url="@Url.Page("/Index")"
     data-antiforgery-token="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
    <noscript><p class="alert alert-warning">The seed editor needs JavaScript.</p></noscript>
</div>

@section Scripts {
    <script type="module" src="~/dist/editor.js" asp-append-version="true"></script>
}
