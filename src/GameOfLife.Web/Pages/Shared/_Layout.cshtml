<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    @* Apply the stored theme choice (or the OS scheme) before first paint; Scripts/shared/theme.ts owns the rules. *@
    <script>(function () { var m = null; try { m = localStorage.getItem("gol.theme"); } catch (e) { } document.documentElement.setAttribute("data-bs-theme", m === "light" || m === "dark" ? m : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")); })();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Game of Life</title>
    @* Bootstrap and the site styles, bundled by esbuild from Scripts/site (see build.mjs). *@
    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-sm bg-body-tertiary border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">Game of Life</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Universe</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Editor">Pattern editor</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @* The page is a fixed-height column: the navbar, then main taking the rest and scrolling on its own if a page needs it. *@
    <main role="main" class="app-main container-fluid">
        @RenderBody()
    </main>

    <script type="module" src="~/dist/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
