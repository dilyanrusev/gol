@page
@model IndexModel
@{
    ViewData["Title"] = "Universe";
}

@if (Model.Message is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
            <span class="badge text-bg-secondary" id="status-connection">connecting…</span>
            <span class="badge text-bg-secondary" id="status-running" aria-live="polite">–</span>
            <span>Generation <strong id="status-generation">–</strong></span>
            <span>Population <strong id="status-population">–</strong></span>
            <span>Viewport <strong id="status-viewport">–</strong> cells</span>
        </div>
        <canvas id="universe" class="universe-canvas w-100 border rounded bg-body-tertiary" tabindex="0"
                aria-label="Game of Life universe viewport. Drag or use arrow keys to pan, scroll or pinch to zoom."></canvas>
        <p class="form-text">Drag to pan, scroll or pinch to zoom. Keyboard: arrows pan, + and - zoom, Home recentres.</p>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Simulation <small class="text-body-secondary">(shared by all clients)</small></div>
            <div class="card-body">
                <div class="btn-group w-100 mb-3" role="group" aria-label="Simulation controls">
                    <button type="button" class="btn btn-success" id="btn-start" disabled>Start</button>
                    <button type="button" class="btn btn-warning" id="btn-pause" disabled>Pause</button>
                    <button type="button" class="btn btn-outline-primary" id="btn-step" disabled>Step</button>
                    <button type="button" class="btn btn-outline-danger" id="btn-reset" disabled>Reset</button>
                </div>
                <label for="speed" class="form-label">Speed: <span id="speed-value">@Model.CurrentSpeed</span> generations/s</label>
                <input type="range" class="form-range" id="speed" min="@Model.MinSpeed" max="@Model.MaxSpeed" value="@Model.CurrentSpeed" disabled />
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Viewport <small class="text-body-secondary">(this client only)</small></div>
            <div class="card-body">
                <div class="d-flex justify-content-center mb-3">
                    <div class="pan-pad" role="group" aria-label="Pan">
                        <span></span>
                        <button type="button" class="btn btn-outline-secondary" data-pan="0,-1" aria-label="Pan up">▲</button>
                        <span></span>
                        <button type="button" class="btn btn-outline-secondary" data-pan="-1,0" aria-label="Pan left">◀</button>
                        <button type="button" class="btn btn-outline-secondary" id="btn-recentre" aria-label="Recentre on seed">⌂</button>
                        <button type="button" class="btn btn-outline-secondary" data-pan="1,0" aria-label="Pan right">▶</button>
                        <span></span>
                        <button type="button" class="btn btn-outline-secondary" data-pan="0,1" aria-label="Pan down">▼</button>
                        <span></span>
                    </div>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-4">
                        <label for="grid-width" class="form-label">Width</label>
                        <input type="number" class="form-control" id="grid-width" min="@Model.MinGridSize" max="@Model.MaxGridSize" value="@Model.DefaultGridSize" />
                    </div>
                    <div class="col-4">
                        <label for="grid-height" class="form-label">Height</label>
                        <input type="number" class="form-control" id="grid-height" min="@Model.MinGridSize" max="@Model.MaxGridSize" value="@Model.DefaultGridSize" />
                    </div>
                    <div class="col-4">
                        <button type="button" class="btn btn-outline-primary w-100" id="btn-resize">Apply</button>
                    </div>
                </div>
                <div class="btn-group w-100 mt-2" role="group" aria-label="Zoom">
                    <button type="button" class="btn btn-outline-secondary" id="btn-zoom-in">Zoom in</button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-zoom-out">Zoom out</button>
                </div>
                <p class="form-text mb-0">Grid size is limited to @Model.MinGridSize–@Model.MaxGridSize cells per side.</p>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Seed</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="mb-3">
                    <label for="file" class="form-label">Upload an .rle pattern</label>
                    <div class="input-group">
                        <input type="file" class="form-control" id="file" name="file" accept=".rle,text/plain" required />
                        <button type="submit" class="btn btn-primary">Load</button>
                    </div>
                    <div class="form-text">Replaces the universe and pauses. Only rule B3/S23 is accepted.</div>
                </form>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary" asp-page="/Editor">Draw a custom seed</a>
                    <a class="btn btn-outline-secondary" asp-page-handler="Export">Save current state as .rle</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script type="module" src="~/js/viewer.js" asp-append-version="true"></script>
}
