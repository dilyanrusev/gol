@page
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Universe";
}

@if (Model.Message is not null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@*
    The React viewer (Scripts/viewer) mounts here. Razor stays the shell: it supplies the server-side
    constants, the anti-forgery token for the upload form and the page URLs through data attributes.
*@
<div id="viewer-root" class="viewer-root"
     data-default-grid-size="@Model.DefaultGridSize"
     data-min-grid-size="@Model.MinGridSize"
     data-max-grid-size="@Model.MaxGridSize"
     data-min-speed="@Model.MinSpeed"
     data-max-speed="@Model.MaxSpeed"
     data-current-speed="@Model.CurrentSpeed"
     data-upload-url="@Url.Page("/Index", "Upload")"
     data-export-url="@Url.Page("/Index", "Export")"
     data-editor-url="@Url.Page("/Editor")"
     data-antiforgery-token="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
    <noscript><p class="alert alert-warning">The universe viewer needs JavaScript.</p></noscript>
</div>

@section Scripts {
    <script type="module" src="~/dist/viewer.js" asp-append-version="true"></script>
}
