{
  "name": "gameoflife-web-client",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "React client for the Game of Life viewer and seed editor, bundled with esbuild",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node build.mjs",
    "build": "npm run typecheck && node build.mjs",
    "build:release": "npm run typecheck && node build.mjs --minify",
    "watch": "node build.mjs --watch"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "bootstrap": "^5.3.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
